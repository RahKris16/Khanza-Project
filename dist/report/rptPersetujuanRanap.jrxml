				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Windu Husada Hospital is responsible for protecting and promoting the rights of patients and families in accordance with Article 32 of Law number 44 of 2009 concerning Hospitals, namely :]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="125" width="502" height="29" uuid="28cb01a1-8388-4f9d-ab82-e7ae866a5284">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Rumah Sakit Windu Husada bertanggung jawab untuk melindungi dan mengedepankan hak pasien dan keluarga sesuai pasal 32 UU No. 44 Tahun 2009 tentang Rumah Sakit yaitu :]]></text>
			</staticText>
			<staticText>
