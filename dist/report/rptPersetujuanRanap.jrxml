		<band height="378">
			<staticText>
				<reportElement x="35" y="97" width="15" height="26" uuid="c4209fce-333c-479e-ba8f-b78065ee3576">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[2.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="110" width="482" height="13" uuid="6306948b-a95f-4254-aaad-883f6ae2df8d"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Using hospital facilities responsibly.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="97" width="482" height="13" uuid="7c18eed0-8b4b-4de3-b210-c64556eb62e5"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Menggunakan fasilitas rumah sakit secara bertanggung jawab.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="123" width="482" height="24" uuid="8a877fbd-ce21-43e3-9154-0b460a6d2e04">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Menghormati hak-hak pasien lain, pengunjung dan hak Tenaga Kesehatan serta petugas lainnya yang bekerja di rumah sakit.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="123" width="15" height="26" uuid="8f0cf3a4-fa0e-4c66-a967-5f109ca084a3">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[3.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="147" width="482" height="13" uuid="fc9c7990-a2a5-40cd-ba98-f13cc0ef17fb"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Respecting the rights of other patients, visitors and the rights of Health Workers and other officers who work in hospital.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="160" width="482" height="24" uuid="7cbc1252-fdfc-4378-901f-c53011a7ad82">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Memberikan informasi yang jujur, lengkap dan akurat sesuai kemampuan dan pengetahuannya tentang masalah kesehatannya.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="160" width="15" height="26" uuid="93b0cb3a-54a7-4677-a141-535bf09231e8">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[4.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="184" width="482" height="24" uuid="b7755fba-1e50-4792-b41d-08c003922292">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Providing honest, complete and accurate information according to their abilities and knowledge about their health problems.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="208" width="482" height="13" uuid="0a6a61b5-08a5-4c87-a212-098d6810faa8"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Memberikan informasi mengenai kemampuan finansial dan jaminan kesehatan yang dimilikinya.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="208" width="15" height="26" uuid="e7de7a9b-14e4-4ddb-be39-2a2a6e531c68">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[5.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="221" width="482" height="13" uuid="c584a37f-37e2-4817-8d69-4f2a3ad1e5e6"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Providing information about their financial capabilities and health insurance.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="234" width="15" height="26" uuid="811d9d43-fe09-4cd7-af8d-00a3fe470986">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[6.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="234" width="482" height="24" uuid="7242f8bf-c982-4f22-b2e3-79212a004c06">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Mematuhi rencana terapi yang direkomendasikan oleh tenaga kesehatan di rumah sakit dan disetujui oleh pasien yang bersangkutan setelah mendapatkan penjelasan sesuai ketentuan peraturan perundang-undangan.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="258" width="482" height="24" uuid="c28170a8-0d6c-4645-80ba-bfa656fa087b">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Complying with the therapy plan recommended by the health worker at the hospital and approved by the patient concerned after receiving an explanation in accordance with the provisions of the legislation.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="282" width="15" height="26" uuid="6a37786e-3614-4b96-bf7a-f33477b20417">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[7.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="317" width="482" height="24" uuid="b861dfa1-8cbd-4b08-b465-df7124eb817d">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Accepting all the consequences of his personal decision to refuse the therapy plan recommended by the Health Worker or do not comply with the instructions given by the Health Worker in the context of curing hi illness or health problem.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="282" width="482" height="35" uuid="8761de4d-8de6-4377-bccc-478b0e73a2cf"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Menerima segala konsekuensi atas keputusan pribadinya untuk menolak rencana terapi yang direkomendasikan oleh Tenaga Kesehatan atau tidak mematuhi petunjuk yang diberikan oleh Tenaga Kesehatan dalam rangka penyembuhan penyakit atau masalah kesehatannya.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="341" width="15" height="26" uuid="b7df2ad7-67cc-45b1-aad0-3d4189a25e2b">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[8.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="354" width="482" height="13" uuid="72653fed-32dc-4719-ad63-2095d64fd408"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Providing compensation for services received.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="341" width="482" height="13" uuid="6865f967-25bb-4b09-9299-16e449c768b3"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Memberikan imbalan jasa atas pelayanan yang diterima.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="84" width="482" height="13" uuid="f2478166-453e-4481-886b-92f40f72c17f"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Complying with hospital regulations.]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="7" width="502" height="13" uuid="e5df9e29-8312-4b4a-bfe6-60fccd62959e">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[KEWAJIBAN PASIEN DAN KELUARGA]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="71" width="15" height="26" uuid="4763829d-58d6-4d3c-a398-64166b6a8350">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[1.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="71" width="482" height="13" uuid="08c86bdd-910c-4c74-b256-32400cb44c20"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Mematuhi peraturan yang berlaku di Rumah Sakit.]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="22" width="502" height="29" uuid="4690f8e1-7e25-4930-832b-6d98cacbad5f">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Rumah Sakit Windu Husada bertanggung jawab untuk melindungi dan mengedepankan kewajiban pasien dan keluarga sesuai Permenkes 69 Tahun 2014, yaitu :]]></text>
			</staticText>
			<staticText>
				<reportElement x="200" y="7" width="330" height="13" uuid="3dfee27b-12ad-4130-841b-d44f139cdf12">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[(RESPONSIBILITIES OF PATIENT AND FAMILY)]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="45" width="502" height="26" uuid="42025e18-7356-4a53-ad2f-98079130ecee">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Windu Husada Hospital is responsible for protecting and prioritizing the obligations of patient and family according to Permenkes 69 of 2014, namely :]]></text>
			</staticText>
		</band>
	</detail>
