			<staticText>
				<reportElement x="50" y="658" width="482" height="24" uuid="6d3f24dc-fad9-46d6-aa9c-5a46d17e4b60">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Apabila uang biaya perawatan sudah melebihi biaya uang muka pasien / keluarga pasien menambah biaya perawatan hari berikutnya.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="682" width="482" height="24" uuid="ea582d1f-7ea6-479e-81ec-efbe9af67922">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[If the treatment fee has exceeded the patient's / family's down payment, the patient's family will add to the next day's treatment costs.]]></text>
			</staticText>
