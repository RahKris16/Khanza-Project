					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Mendapatkan privasi dan kerahasiaan penyakit yang diderita termasuk data-data medisnya.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="439" width="482" height="35" uuid="845454e9-6155-4c32-9815-c3ee58fa20f5"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Mendapat informasi yang meliputi diagnosis dan tata cara tindakan medis, tujuan tindakan medis, alternatif tindakan, resiko dan komplikasi yang mungkin terjadi dan prognosis terhadap tindakan yang dilakukan serta perkiraan biaya pengobatan.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="439" width="15" height="26" uuid="7e6fe6c9-98e9-4dbe-8657-615a424e5a33">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[10.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="474" width="482" height="35" uuid="69805aea-cfc7-4453-8987-2b4423840cc6">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Obtaining information about the diagnosis and medical treatment, procedures, medical treatment, procedures, medical treatment purposes, alternative measures, risks and possible complications, and prognosis of the actions taken and the estimated cost of treatment.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="509" width="482" height="24" uuid="77ee56b7-787b-4030-8343-0dc427a64aa8">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Memberikan persetujuan atau menolak atas tindakan yang akan dilakukan oleh tenaga kesehatan terhadap penyakit yang dideritanya.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="509" width="15" height="26" uuid="3800ac53-d198-4be4-b7d2-d9e50bb3017a">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[11.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="533" width="482" height="13" uuid="231f236c-5069-4a4d-ba55-364b2beaa7c2"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Consenting of refusing any treatment to be performed / applied.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="546" width="15" height="26" uuid="fe0100d4-1335-4e2f-9962-a54d826cf5ae">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[12.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="546" width="482" height="13" uuid="68640f90-bd36-40c8-a095-76981b4585b2"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Didampingi keluarganya dalam keadaan kritis.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="559" width="482" height="13" uuid="7b26b336-5aa4-4c21-9150-b37f68a62be9"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Accompanied by family in a critical condition.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="572" width="482" height="13" uuid="3d01ce84-bf8e-410f-b79c-39a6de2430e3"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Menjalankan ibadah sesuai agama atau kepercayaan yang dianutnya selama itu tidak mengganggu pasien lainnya.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="572" width="15" height="26" uuid="e72114bd-5c38-43e5-9b2b-ff0ce80f2f74">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[13.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="585" width="482" height="13" uuid="a9943ad8-3fde-4113-97c4-e98ec1e56dab"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Practicing religion or beliefs as long as it does not disturb other patients.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="598" width="482" height="13" uuid="7b719aa4-d288-4654-9dac-5adb82163486"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Memperoleh keamanan dan keselamatan dirinya selama dalam perawatan di Rumah Sakit.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="598" width="15" height="26" uuid="1bcf1076-9d94-49ee-af79-a622b0479bff">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[14.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="611" width="482" height="13" uuid="8cad29f5-7ffd-41b2-ae6b-66e0d596ff69"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Acquiring security and safety during treatment in the hospital.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="624" width="482" height="13" uuid="2ca61b36-7c38-4d79-b728-2c86d16eed9c"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Mengajukan usul, saran, perbaikan atas perlakuan Rumah Sakit terhadap dirinya.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="624" width="15" height="26" uuid="73a7a90f-4511-4968-9de7-b17ee183c17c">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[15.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="637" width="482" height="13" uuid="fc04d701-6054-4d95-b134-640cd08e8d2d"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Submitting, suggestions, feedbacks on treatments received in the hospital.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="663" width="482" height="13" uuid="13a84c3f-17e9-4192-bc52-8a8943faaf0c"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Refusing spiritual religious guidance services not in accordance with one's religion and belief.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="650" width="15" height="26" uuid="caf5ce6b-40b0-4bdf-9956-02aa12d0f83e">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[16.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="650" width="482" height="13" uuid="c820a9e0-5192-4ec8-aa17-c713d8a68644"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Menolak bimbingan rohani yang tidak sesuai dengan agama dan kepercayaan yang dianutnya.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="676" width="15" height="26" uuid="4bd6fc4e-ad69-4ebf-a359-bec8b9f258e4">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[17.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="676" width="482" height="24" uuid="d5d687ac-da24-4d3f-bb43-9aa45264fdfd">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Menggugat atau menuntut Rumah Sakit apabila Rumah Sakit diduga memberikan pelayanan yang tidak sesuai dengan standar baik secara perdata maupun pidana.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="700" width="482" height="13" uuid="72744442-3784-4a5e-8576-efb0abc2d62f"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Accusing or prosecuting hospital that is allenged for breaching standards either in civil or criminal.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="713" width="482" height="24" uuid="5ea057eb-12e9-45b7-807e-dba241c0f999">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Mengeluhkan pelayanan Rumah Sakit yang tidak sesuai dengan standar pelayanan melalui media cetak dan elektronik sesuai dengan ketentuan peraturan perundang-undangan.]]></text>
			</staticText>
			<staticText>
				<reportElement x="50" y="737" width="482" height="24" uuid="2884ba44-5c83-453e-8b05-ff30c2cd91e7">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Questioning the hospital services that do not conform to the standards of service through print and electronic media in accordance with statutory law.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="713" width="15" height="26" uuid="0f1d15a7-2e66-421f-a98d-8fb0e0932e63">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[18.]]></text>
			</staticText>
