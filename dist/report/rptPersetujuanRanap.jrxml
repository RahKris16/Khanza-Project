					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Obtaining privacy and confidentiality regarding the patient's illness.]]></text>
			</staticText>
