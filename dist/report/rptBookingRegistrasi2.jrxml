	<queryString>
		<![CDATA[SELECT d.nm_dokter,p.nm_poli,COUNT(d.nm_dokter) as jumlah,j.jam_mulai,
                IF(j.jam_mulai>='14:00:00','Sore','Pagi') as waktu
                FROM booking_registrasi br
                inner join dokter d on d.kd_dokter =br.kd_dokter
                INNER join poliklinik p on p.kd_poli =br.kd_poli
                Inner join jadwal j on j.kd_dokter =br.kd_dokter]]>
	</queryString>
