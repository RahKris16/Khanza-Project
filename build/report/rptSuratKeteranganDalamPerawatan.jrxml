	<queryString>
		<![CDATA[SELECT s.no_skdp,s.no_rawat,DATE_FORMAT(s.tanggal_surat,'%d-%m-%Y') as tanggal_surat,s.no_rkm_medis,p.nm_pasien,CONCAT(rp.umurdaftar,' ',rp.sttsumur) as umur,s.no_rujukan," +
                    "DATE_FORMAT(bs.tglrujukan,'%d-%m-%Y') as tglrujukan,DATE_FORMAT(DATE_ADD(bs.tglrujukan, INTERVAL 90 DAY),'%d-%m-%Y') AS expired,DATE_FORMAT(s.tanggal_kontrol,'%d-%m-%Y') as tanggal_kontrol," +
                    "s.diagnosa,s.rtl,s.kd_dokter,d.nm_dokter,IFNULL(jf.jam,"") as jam " +
                    "FROM skdp s " +
                    "inner join pasien p on p.no_rkm_medis=s.no_rkm_medis " +
                    "inner join reg_periksa rp on rp.no_rawat =s.no_rawat " +
                    "inner join bridging_sep bs on bs.no_rujukan =s.no_rujukan and bs.no_rawat =s.no_rawat " +
                    "inner join dokter d on d.kd_dokter =s.kd_dokter " +
                    "left join jadwal_fisio jf on jf.no_surat =s.no_skdp]]>
	</queryString>
