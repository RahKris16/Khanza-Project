	<queryString>
		<![CDATA[select date_format(reg_periksa.tgl_registrasi, '%d-%m-%Y') as tanggal,reg_periksa.no_rawat,reg_periksa.no_rkm_medis,pasien.nm_pasien,protokol.umur,protokol.jenis_kelamin,protokol.alamat,
protokol.kd_dokter,dokter.nm_dokter,protokol.diagnosa_utama,protokol.kd_diagnosa_utama,protokol.diagnosa_sekunder,protokol.kd_diagnosa_sekunder,protokol.diagnosa_sekunder2,protokol.kd_diagnosa_sekunder2,
protokol.diagnosa_sekunder3,protokol.kd_diagnosa_sekunder3,protokol.diagnosa_sekunder4,protokol.kd_diagnosa_sekunder4,
protokol.obat_pulang,protokol.alasan,protokol.selama from protokol inner join reg_periksa on protokol.no_rawat=reg_periksa.no_rawat  
inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis inner join dokter on protokol.kd_dokter=dokter.kd_dokter
where protokol.no_rawat= $P{norawat}]]>
	</queryString>
