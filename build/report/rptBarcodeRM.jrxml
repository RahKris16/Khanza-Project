	<queryString>
		<![CDATA[select if(p2.kd_poli='IGD' or p2.kd_poli='U0024' or p2.kd_poli='U0025' or p2.kd_poli='U0027' or p2.kd_poli='U0031'or p2.kd_poli='U0032' or p2.kd_poli='U0033' or p2.kd_poli='U0034','',rp.no_reg) as no_reg ,
p.no_rkm_medis, p.nm_pasien,p.jk,p.tgl_lahir,p.umur,p3.png_jawab,
if(p2.kd_poli='IGD' or p2.kd_poli='U0024' or p2.kd_poli='U0025' or p2.kd_poli='U0027' or p2.kd_poli='U0031'or p2.kd_poli='U0032' or p2.kd_poli='U0033' or p2.kd_poli='U0034','',d.nm_dokter) as nm_dokter,
if(p2.kd_poli='IGD' or p2.kd_poli='U0024' or p2.kd_poli='U0025' or p2.kd_poli='U0027' or p2.kd_poli='U0031'or p2.kd_poli='U0032' or p2.kd_poli='U0033' or p2.kd_poli='U0034','',p2.nm_poli) as nm_poli 
from reg_periksa rp
inner join pasien p on p.no_rkm_medis=rp.no_rkm_medis
inner join dokter d on d.kd_dokter=rp.kd_dokter 
inner join poliklinik p2 on p2.kd_poli=rp.kd_poli
inner join penjab p3 on p3.kd_pj =rp.kd_pj]]>
	</queryString>
