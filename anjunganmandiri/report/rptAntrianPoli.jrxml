		<![CDATA[select pasien.nm_pasien, reg_periksa.no_rkm_medis, reg_periksa.jam_reg, reg_periksa.no_reg, reg_periksa.tgl_registrasi, dokter.nm_dokter, poliklinik.nm_poli, penjab.png_jawab from reg_periksa inner join dokter INNER JOIN poliklinik INNER join penjab inner join pasien on reg_periksa.kd_dokter=dokter.kd_dokter and reg_periksa.kd_poli=poliklinik.kd_poli and reg_periksa.no_rkm_medis=pasien.no_rkm_medis AND reg_periksa.kd_pj=penjab.kd_pj where reg_periksa.no_rawat=$P{no_rawat}]]>
