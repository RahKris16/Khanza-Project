	<queryString>
		<![CDATA[SELECT p.no_rkm_medis ,p.nm_pasien ,DATE_FORMAT(p.tgl_lahir, '%d-%m-%Y') as tgl_lahir ,CONCAT(p.alamat,', ',k.nm_kel,', ',k2.nm_kec,', ',k3.nm_kab,', ',p2.nm_prop) as alamat
		FROM pasien p inner join kelurahan k on k.kd_kel =p.kd_kel INNER join kecamatan k2 on k2.kd_kec =p.kd_kec 
		inner join kabupaten k3 on k3.kd_kab =p.kd_kab inner join propinsi p2 on p2.kd_prop =p.kd_prop]]>
	</queryString>
