	<detail>
		<band height="731" splitType="Stretch">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<staticText>
				<reportElement x="35" y="36" width="20" height="20" uuid="97a7265d-c3fd-40fa-a377-0ec828abd0fd">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[1.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="70" width="478" height="40" uuid="daa0a596-6d77-4bf7-82c9-ad1156c5a1a8">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[PATIENT RIGHTS AND RESPONSIBILITIES. I acknowledge that during the registration process to obtain medical care in Windu Husada Hospital and by signing this document, I have received information about the rights and responsibilities as a patient.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="110" width="478" height="106" uuid="8d4febba-b77a-450d-8945-c133c309aceb">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[PERSETUJUAN PELAYANAN KESEHATAN. Saya menyetujui dan memberikan persetujuan untuk mendapat pelayanan Kesehatan di Rumah Sakit Windu Husada. Dengan ini saya meminta dan memberikan kuasa kepada Rumah Sakit Windu Husada, dokter dan perawat, dan tenaga kesehatan lainnya untuk memberikan asuhan perawatan, pemeriksaan fisik yang dilakukan oleh dokter dan perawat dan melakukan prosedur diagnostik, radiologi dan terapi dan tatalaksana sesuai pertimbangan dokter yang diperlukan atau disarankan pada perawatan saya. Hal ini mencakup seluruh pemeriksaan dan prosedur diagnostik rutin, termasuk x-ray, pemberian dan tindakan medis serta penyuntikan (intramuscular, intravena dan prosedur invasif lainnya) produk farmasi dan obat-obatan, pemasangan alat kesehatan (kecuali yang membutuhkan persetujuan khusus/tertulis), dan pengambilan darah untuk pemeriksaan laboratorium atau pemeriksaan patologi yang dibutuhkan untuk pengobatan dan tindakan yang aman]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="110" width="20" height="20" uuid="9c6299b7-b597-455d-961a-43774a880238">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[2.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="36" width="478" height="40" uuid="aa523aab-e788-48e5-b82a-182e3d5800c5">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[HAK DAN KEWAJIBAN SEBAGAI PASIEN. Saya mengakui bahwa pada proses pendaftaran untuk mendapatkan perawatan di Rumah Sakit Windu Husada dan penandatanganan dokumen ini, saya telah mendapat informasi tentang hak-hak dan kewajiban saya sebagai pasien.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="210" width="478" height="106" uuid="963d32ad-0751-4a83-b641-46e1237dd845">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[HEALTH SERVICES CONSENT. I agree and give my consent to receive healthcare services at Windu Husada Hospital. Hereby, I request and authorize Windu Husada Hospital, doctors, nurses, and other healthcare professionals to provide care, conduct physical examinations performed by doctors and nurses, and carry out diagnostic, radiology, and therapeutic procedures and management as deemed necessary or recommended by the doctor for my treatment. This includes all routine examinations and diagnostic procedures, including x-rays, administration of medical actions and injections (intramuscular, intravenous, and other invasive procedures), pharmaceutical products and medications, the use of medical devices (except those requiring special/written consent), and blood collection for laboratory or pathology tests required for safe treatment and procedures.]]></text>
			</staticText>
			<staticText>
				<reportElement x="152" y="3" width="269" height="16" uuid="db2ed91f-d53a-4de0-8167-fcc8e21b616e"/>
				<textElement textAlignment="Center">
					<font fontName="Tahoma" size="10"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[PERSETUJUAN UMUM]]></text>
			</staticText>
			<staticText>
				<reportElement x="152" y="16" width="269" height="16" uuid="07ba7183-1a11-456c-97b8-572a5d96e1d6"/>
				<textElement textAlignment="Center">
					<font fontName="Tahoma" size="10" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[GENERAL CONSENT]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="309" width="478" height="40" uuid="912b5af6-3ad6-47bb-b905-9b8eb6b1abd7">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[PRIVASI DAN PERLINDUNGAN. Saya memberi kuasa kepada Rumah Sakit Windu Husada untuk menjaga privasi dan kerahasiaan penyakit saya selama dalam perawatan, termasuk perlindungan terhadap kekerasan fisik selama saya dalam perawatan.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="344" width="478" height="26" uuid="e5cd5bf1-4f32-4f46-b775-c6d3ddc25a31">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[PRIVACY AND PROTECTION. I authorize Windu Husada Hospital to maintain the privacy and confidentiality of my illness during treatment, including protection against physical violence while I am under care.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="309" width="20" height="20" uuid="51e1a0ba-e3ad-4783-87fb-d89b54d62ebc">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[3.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="372" width="478" height="28" uuid="f9b303f5-4b85-4125-87b5-45fb9ade9cc5">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[PENGGUNAAN KAMERA DAN ALAT PEREKAM. Saya bersedia menyetujui ketentuan penggunaan kamera untuk keperluan foto dan/atau video dengan ketentuan sebagai berikut:]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="397" width="463" height="90" uuid="a22c6323-fed2-4304-942b-d5d039fce1c6">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Saya bersedia untuk tidak menggunakan kamera/alat perekam lainnya untuk keperluan foto dan/atau video yang berkaitan dengan tindakan dan pelayanan medis di lingkungan Rumah Sakit Windu Husada serta menyebarluaskannya ke media masa tanpa izin tertulis kepada Manajemen Rumah Sakit Windu Husada.
Saya bersedia dan menyetujui penggunaan kamera untuk keperluan foto dan/atau video yang berkaitan dengan kebutuhan medis yang dilakukan oleh dokter, tenaga medis dan/atau karyawan Rumah Sakit Windu Husada seperti kebutuhan untuk dokumentasi konsultasi spesialis, kebutuhan klaim asuransi dan kebutuhan lain sesuai persetujuan Manajemen Rumah Sakit Windu Husada selama tidak melanggar hak kebijakan privasi pasien dan/atau keluarga pasien sesuai ketentuan peraturan perundang-undangan yang berlaku.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="488" width="478" height="28" uuid="db045208-5549-462f-a291-40fac0146bc9">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[USE OF CAMERAS AND RECORDING DEVICES. I agree to the terms of using cameras for photo and/or video purposes under the following conditions:]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="516" width="463" height="90" uuid="741f1b64-606a-42f7-be54-1c29de898332">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[I am willing not to use cameras or other recording devices for the purpose of taking photos and/or videos related to medical actions and services within Windu Husada Hospital, as well as not to distribute them through mass media without written permission from the Management of Windu Husada Hospital.
I am willing and agree to the use of cameras for photo and/or video purposes related to medical needs carried out by doctors, medical staff, and/or employees of Windu Husada Hospital, such as for specialist consultation documentation, insurance claim requirements, and other needs as approved by the management of Windu Husada Hospital, as long as it does not violate the privacy rights of patients and/or their families in accordance with applicable laws and regulations.
]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="372" width="20" height="20" uuid="e0dbb938-ccf6-4bac-b623-d14a2470e98d">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[4.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="608" width="478" height="52" uuid="956b8f64-58a5-4bf6-b0ec-ae1b973ac5b4">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[PELEPASAN KERAHASIAAN REKAM MEDIS. Saya setuju apabila pasien dan/ atau keluarga pasien yang menginformasikan isi rekam medis kepada publik melalui media massa dianggap telah melakukan pelepasan hak rahasia isi rekam medis kepada umum. Maka pihak Rumah Sakit Windu Husada berwenang untuk mengungkapkan rahasia isi rekam medis sebagai hak jawab fasilitas pelayanan kesehatan.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="654" width="478" height="52" uuid="7bbedf64-94fe-4b8b-a3cd-7c1ce990ebb9">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[DISCLOSURE OF MEDICAL RECORD CONFIDENTIALITY. I agree that if the patient and/or the patient’s family discloses the contents of the medical record to the public through mass media, it shall be considered as a waiver of the right to confidentiality of the medical record. Therefore, Windu Husada Hospital shall have the authority to disclose the confidential contents of the medical record as the healthcare facility’s right of reply.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="608" width="20" height="20" uuid="12aff384-6dae-47de-9082-43a7ff0bf0cf">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[5.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="397" width="15" height="20" uuid="07f8b8f2-d085-4f31-b4c1-d563e160eed1">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="430" width="15" height="20" uuid="d6653495-cd92-49e6-b7ab-096c76e99377">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="516" width="15" height="20" uuid="b079526a-01a9-4cb6-a5cd-10af01831bf5">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="549" width="15" height="20" uuid="01009566-f1e7-4dd9-a4a3-167f2313e063">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
		</band>
		<band height="802" splitType="Stretch">
			<textField>
				<reportElement mode="Opaque" x="77" y="405" width="444" height="13" uuid="51abf091-f3a9-408d-9490-684802e977c4">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nama_pj}+" ("+$F{bertindak_atas}+")"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="55" y="84" width="478" height="30" uuid="7d1b7737-ed5f-4bce-b8d5-f471af60e4b5">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[MEMBUKA RAHASIA KEDOKTERAN. Saya setuju untuk membuka rahasia kedokteran terkait dengan kondisi kesehatan, asuhan dan pengobatan yang saya terima kepada :]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="84" width="20" height="20" uuid="2a9591d8-4273-457a-a7ae-1cc9e8be3cd6">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[7.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="108" width="478" height="30" uuid="1d862c37-33a4-4b0d-bc00-842b21131924">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[REVELATION OF MEDICAL CONFIDENTIALITY. I agree to reveal the medical confidentiality related to health conditions, care and treatment I received to :]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="0" width="478" height="52" uuid="13768dd1-2a16-43e4-96c8-ddb9ade78285">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[PELEPASAN KERAHASIAAN REKAM MEDIS. Saya setuju apabila pasien dan/ atau keluarga pasien yang menginformasikan isi rekam medis kepada publik melalui media massa dianggap telah melakukan pelepasan hak rahasia isi rekam medis kepada umum. Maka pihak Rumah Sakit Windu Husada berwenang untuk mengungkapkan rahasia isi rekam medis sebagai hak jawab fasilitas pelayanan kesehatan.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="0" width="20" height="20" uuid="aa6b17a9-339e-4e49-a8e7-98e888311d24">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[6.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="46" width="478" height="43" uuid="052b1364-fad2-4326-a37e-2c254eeedd50">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[MEDICAL CONFIDENTIAL. I agree that Windu Husada Hospital is required to guarantee confidentiality of my medical care or treatment weather for the purpose of education and research unless I reveal themselves or others that I give power as guarantor.]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="132" width="462" height="19" uuid="d3658869-7aff-4b6a-9ae0-a9ce8133b73c">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Dokter dan tenaga kesehatan lain yang memberikan asuhan kepada saya.]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="144" width="462" height="19" uuid="fea9789a-9973-4c43-a8bf-30b86d22c5e9">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Doctors and other health professionals who provide care to me.]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="156" width="462" height="19" uuid="1330d67f-9cd0-479f-b8d9-d5cfde7315a8">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Perusahaan asuransi kesehatan atau perusahaan lainnya atau pihak lain yang menjamin pembiayaan saya.]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="168" width="462" height="19" uuid="f0779fd7-b027-4942-94b6-d035ffbef962">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Health insurance companies or other companies or other parties that guarantees my financing.]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="180" width="462" height="41" uuid="f5129f07-5131-4a4c-a58b-8599e5515829">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Saya mengetahui dan menyetujui bahwa berdasarkan Peraturan Menteri Kesehatan Nomor 24 Tahun 2022 tentang Rekam Medis, fasilitas pelayanan kesehatan wajib membuka akses dan mengirimkan data rekam medis kepada Kementrian Kesehatan melalui platform SATUSEHAT.]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="213" width="462" height="41" uuid="8c451fe4-1151-4e0a-9e54-a15debc99525">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[I acknowledge and agree that, based on the Regulation of the Minister of Health Number 24 of 2022 concerning Medical Records, healthcare facilities are required to provide access to and submit medical record data to the Ministry of Health through the SATUSEHAT platform.]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="245" width="462" height="26" uuid="09590366-08bb-4b3e-b2df-c72dd3ac0555">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Menyetujui untuk menerima dan membuka data pasien dari fasilitas pelayanan Kesehatan lainnya melalui SATUSEHAT untuk kepentingan pelayanan Kesehatan dan / atau rujukan.]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="267" width="462" height="24" uuid="a38cce6f-0b72-44eb-9d82-3c81fd391de8">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Agree to disclose patient is data from other Health service facilities through SATUSEHAT for Health services and or referrals.]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="289" width="462" height="42" uuid="96194a8b-e417-4def-9c6f-d9d8f2c70e28">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Program nasional sesuai yang berlaku, meliputi namun tidak terbatas pada : Program Skrining Hipotiroid Kongetial (SHK), Program Kesehatan Ibu dan Anak (KIA), Program Pelayanan Keluarga Berencana Rumah Sakit termasuk pelaporan AKI dan AKB, Program Tuberkulosis, Program Stunting dan Program HIV/AIDS.]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="323" width="462" height="38" uuid="69ed71a4-f15d-46aa-9019-4ae505afbcd3">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[National programs in accordance with applicable regulations, include but are not limited to: Congenital hypothyroidism screening program (SHK), maternal and neonatal program (KIA), contraception program including AKI and AKB reporting, tuberculosis program, stunting program and HIV/AIDS program.]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="356" width="462" height="25" uuid="c0cda526-f30a-46bc-98fc-a1a2672c06c0">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Saya memberi wewenang kepada pihak rumah sakit untuk memberikan informasi tentang diagnosis dan hasil pelayanan serta pengobatan kepada anggota keluarga saya, dan kepada :]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="379" width="462" height="25" uuid="55083097-b54f-4e50-b3e0-793506eb0cde">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[I authorize the hospital to inform the diagnosis and the treatment outcomes as well as services to members of my family or to :]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="408" width="462" height="20" uuid="f78df04e-7aed-49df-8d59-e4864f944ef7"/>
				<textElement>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[(...................................................................................................................................................................)]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="426" width="478" height="57" uuid="fccdc5d9-e367-42cc-b9ce-682e8f4f4b29">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[BARANG PRIBADI. Saya setuju untuk tidak membawa barang-barang berharga yang tidak diperlukan (seperti: perhiasan, elektronik, dll) selama dalam perawatan di Rumah Sakit Windu Husada. Saya memahami dan menyetujui bahwa apabila saya membawanya, maka Rumah Sakit Windu Husada tidak bertanggung jawab terhadap kehilangan, kerusakan atau pencurian. Apabila saya membutuhkan, maka saya dapat menitipkan barang-barang saya kepada Rumah Sakit Windu Husada sesuai dengan prosedur yang sudah ditetapkan.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="481" width="478" height="57" uuid="08d3f2bd-754a-4040-8ed0-fca039fbb73e">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[PRIVATE BELONGING. I agree not to bring valuable belongings that are not required (such as: jewelry, electronics, etc) during my treatment in Windu Husada Hospital. I understand and agree that Windu Husada Hospital is not responsible for any loss, damage or thievery. If I need it, I can entrust my belongings to Windu Husada Hospital according to established procedures.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="531" width="478" height="24" uuid="cb946602-bc32-4ca8-ab9c-8152f1514453">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[LAYANAN KEROHANIAN. Saya menyatakan bahwa saya telah menerima informasi tentang adanya layanan kerohanian di Rumah Sakit Windu Husada, untuk mendampingi pasien disesuaikan dengan kepercayaan masing-masing.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="555" width="478" height="31" uuid="0d074161-727d-4e0e-bbd9-e6192a5b57d2">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[SPIRITUAL SERVICES. I certify that I have received information about the existence of spiritual services at Windu Husada Hospital, to accompany patients according to their individual beliefs.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="618" width="478" height="41" uuid="2a9ffdbe-e2cf-44cf-9eb8-9881c178d0d2">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[DELIVERING COMPLAINTS. I certify that I have received information about the procedures on resolving complaints related to medical services provided to me. I agree to follow the procedure for filing a complaint according to existing procedures.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="584" width="478" height="34" uuid="6815f6ce-5383-4b11-aaf1-1af2b2cbd497">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[PENGAJUAN KELUHAN. Saya menyatakan bahwa saya telah menerima informasi tentang adanya tatacara mengajukan dan mengatasi keluhan terkait pelayanan medik yang diberikan terhadap diri saya. Saya setuju untuk mengikuti tatacara mengajukan keluhan sesuai prosedur yang ada.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="658" width="478" height="47" uuid="33178918-d27f-4c55-94ef-cd4693b63cea">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[KEWAJIBAN PEMBAYARAN. Saya menyatakan setuju, baik sebagai wali atau sebagai pasien, bahwa sesuai pertimbangan pelayanan yang diberikan kepada pasien, maka saya wajib untuk membayar total biaya pelayanan. Biaya pelayanan berdasarkan acuan biaya dan ketentuan Rumah Sakit Windu Husada. Saya juga menyadari dan memahami bahwa :]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="702" width="478" height="41" uuid="fc1c9ffe-2d35-4d21-9fa0-3a92f8a723fa">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isItalic="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[PAYMENT OBLIGATION. I agree, either as trustee or as a patient, I am obliged to pay the total cost of the service based on appropriate consideration of the services provided to the patient. The service charge is based on the reference costs and provisions of Windu Husada Hospital. I also realize and understand that :]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="736" width="463" height="39" uuid="baee82ba-e9a1-409b-a7f4-407055c5b6e5">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Apabila saya memberikan persetujuan, atau dikemudian hari mencabut persetujuan saya untuk melepaskan
rahasia kedokteran saya kepada perusahan asuransi yang saya tentukan, maka saya pribadi bertanggung jawab untuk membayar semua pelayanan dan tindakan medis di Rumah Sakit Windu Husada.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="426" width="20" height="20" uuid="938a4bf8-ab5c-49fa-b4ea-3858c21a399a">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[8.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="531" width="20" height="20" uuid="71517b25-9c41-44dd-a7c3-b0989dd9f7e7">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[9.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="584" width="20" height="20" uuid="4a9cc5ec-87b7-4f7a-a2f5-b9cd5b9231a3">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[10.]]></text>
			</staticText>
			<staticText>
				<reportElement x="35" y="658" width="20" height="20" uuid="9f96c134-3084-4c69-9521-fabae3f714a2">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[11.]]></text>
			</staticText>
			<staticText>
				<reportElement x="55" y="132" width="15" height="20" uuid="073e275e-0fca-487b-ad99-7372a27b45ce">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Tahoma" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[•]]></text>
			</staticText>
			<staticText>
