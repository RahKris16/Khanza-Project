	<queryString>
		<![CDATA[select surat_gadar.no_rawat,reg_periksa.no_rkm_medis,concat(reg_periksa.umurdaftar,' ',reg_periksa.sttsumur) as umur,pasien.nm_pasien,pasien.jk as kelamin,
DATE_FORMAT(surat_gadar.tanggal_periksa,'%d-%m-%Y') as tgl_periksa,surat_gadar.jam_periksa,surat_gadar.rawat_inap,surat_gadar.kd_dokter,dokter.nm_dokter,surat_gadar.diagnosa,surat_gadar.kd_diagnosa                
from surat_gadar inner join reg_periksa on surat_gadar.no_rawat=reg_periksa.no_rawat inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis inner join dokter on dokter.kd_dokter=surat_gadar.kd_dokter]]>
	</queryString>
